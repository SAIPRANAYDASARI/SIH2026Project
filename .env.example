# ---------------------------------------------------------------------------
# Manak Sahayak — environment configuration
# Copy this file to `.env` in the repo root and fill in real values.
# Every variable the stack reads is documented here; nothing is implicit.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
APP_ENV=development                 # development | test | production
APP_NAME=manak-sahayak
APP_SECRET_KEY=change-me-to-a-random-64-char-string   # used to sign session cookies / JWTs
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR

# --- Postgres ----------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=manak_sahayak
POSTGRES_USER=manak
POSTGRES_PASSWORD=change-me
# Async SQLAlchemy URL built from the above by backend/app/core/config.py.
# Override directly if connecting to a managed/hosted Postgres instead:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# --- Redis (rate limiting, Celery broker/result backend, SSE fanout) --------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=redis://redis:6379/0   # overrides the three above if set

# --- Celery ------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- LLM adapter (pluggable — see docs/DECISIONS.md, decision #3) -----------
# Selects which backend the model adapter uses. Switchable per-request via the
# `model_backend` field on POST /api/v1/chat as well.
LLM_BACKEND=ollama                  # ollama | hosted

# Hosted API backend (used when LLM_BACKEND=hosted, or per-request override)
# "openai" = speaks the OpenAI chat/completions wire format, not literally
# OpenAI's API — this is how NVIDIA NIM's free-tier API, Groq, Together, etc.
# are supported too, by pointing HOSTED_LLM_BASE_URL at their endpoint.
HOSTED_LLM_PROVIDER=openai          # anthropic | openai
HOSTED_LLM_API_KEY=                 # <-- ASK THE USER FOR THIS. Never commit a real key.
# Example (NVIDIA NIM free tier — https://build.nvidia.com, OpenAI-compatible):
HOSTED_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
HOSTED_LLM_MODEL=meta/llama-3.1-70b-instruct
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2

# Local Ollama backend (used when LLM_BACKEND=ollama; also the offline-demo path)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=bge-m3

# --- Retrieval ---------------------------------------------------------------
EMBEDDING_DIM=1024                  # BGE-M3 output dimension
RRF_K=60                            # reciprocal rank fusion constant
RERANK_TOP_K=8                      # chunks passed to the answer composer after reranking
SPARSE_CANDIDATE_K=50               # candidates pulled from BM25 before fusion
DENSE_CANDIDATE_K=50                # candidates pulled from dense search before fusion
RERANKER_BASE_URL=http://reranker:7997   # local Infinity server (bge-reranker-v2-m3)
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- Translation (Step 10 — pluggable, app/translate/client.py) -------------
# Default is "none": the whole system works fully offline with zero network
# egress for this. Set to "bhashini" to translate final chat answers via
# Bhashini (India's government multilingual API, https://bhashini.gov.in).
TRANSLATION_BACKEND=none
# An inline comment after an empty value here would become part of the
# value itself (pydantic-settings' env-file parser only strips inline
# comments when there's a real value before them) — so these are documented
# above the line, not after it, unlike most of this file.
# ASK THE USER FOR THIS when enabling Bhashini. Never commit a real key.
BHASHINI_API_KEY=
# ASK THE USER FOR THIS too — Bhashini auth needs both.
BHASHINI_USER_ID=
BHASHINI_BASE_URL=https://meity-auth.ulcacontrib.org
# obtained once from the Bhashini dashboard for your language pairs
BHASHINI_PIPELINE_ID=

# --- Auth --------------------------------------------------------------------
JWT_SECRET_KEY=change-me-to-a-different-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_COOKIE_NAME=ms_session
SESSION_COOKIE_SECURE=false         # set true behind HTTPS in production

# --- Rate limiting -------------------------------------------------------------
RATE_LIMIT_PER_MINUTE_ANON=20
RATE_LIMIT_PER_MINUTE_AUTH=60

# --- CORS ----------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Blob storage (raw crawled documents, Step 2+) ---------------------------
BLOB_STORE_PATH=/data/blobs

# --- Seed / demo data (Step 13) ----------------------------------------------
SEED_DEMO_DATA=false
